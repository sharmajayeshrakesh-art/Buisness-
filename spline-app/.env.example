# ---------------------------------------------------------------------------
# Spline scene URLs. Copy this file to `.env` and paste your scene URLs here.
# Get a URL from Spline: Export ▸ "React" (or "Code") ▸ copy the .splinecode URL,
# which looks like: https://prod.spline.design/XXXXXXXX/scene.splinecode
#
# You can EITHER set these env vars OR edit src/config/scenes.js directly.
# Env vars win over the values in scenes.js.
# ---------------------------------------------------------------------------

VITE_SPLINE_HERO=
VITE_SPLINE_SHOWCASE=
# Add more as you add scenes to src/config/scenes.js, e.g.:
# VITE_SPLINE_CONTACT=
